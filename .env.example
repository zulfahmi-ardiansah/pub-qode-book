# LLM endpoint (OpenAI-compatible). Default targets OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash

# Optional: restrict OpenRouter to specific providers (comma-separated).
LLM_PROVIDER=

# Optional: path to the SQLite database. Relative paths are read from the
# project root, not from the directory the command was run in.
SQLITE_PATH=data/database.sqlite

# Optional: the port the app is served on. Used by docker compose — it is both
# the port uvicorn listens on inside the container and the port published on
# your machine. Running uvicorn directly, pass --port instead.
PORT=8000

# Optional budget guard. Prices are USD per 1,000,000 tokens (OpenRouter style).
# When set > 0, the run tracks spend from each response's token usage and aborts
# once accumulated cost reaches LLM_BUDGET_USD. Leave LLM_BUDGET_USD empty/0 to
# disable the guard.
LLM_BUDGET_USD=
LLM_INPUT_PRICE=
LLM_OUTPUT_PRICE=
